generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Geo
model Region {
  id     String    @id @default(uuid())
  name   String    @unique
  region Address[] // 1:N region:address
}

model City {
  id   String    @id @default(uuid())
  name String    @unique
  city Address[] // 1:N city:address
}

// Organization
model Company {
  id      String    @id @default(uuid())
  name    String    @unique
  company Contact[] // 1:N company:user

  @@map("Companies")
}

model Department {
  id         String    @id @default(uuid())
  name       String    @unique
  department Contact[] // 1:N company:department

  @@map("Departments")
}

model Position {
  id       String    @id @default(uuid())
  name     String    @unique
  position Contact[] // 1:N company:position

  @@map("Positions")
}

// Base
model Phone {
  id     String    @id @default(uuid())
  phone  String
  type   PhoneType
  userId String
  user   Contact   @relation(fields: [userId], references: [id], onDelete: Cascade) // 1:N phone:user

  @@unique([userId, type])
  @@map("Phones")
}

enum PhoneType {
  WORK
  MOBILE
  HOME
  OTHER
}

model Address {
  id String @id @default(uuid())

  region   Region @relation(fields: [regionId], references: [id]) // 1:1 address:region
  regionId String @map("region_id") // 1:1 address:region

  city   City   @relation(fields: [cityId], references: [id]) // 1:1 address:city
  cityId String @map("city_id") // 1:1 address:city

  street    String
  building  Int
  apartment Int

  user   Contact @relation(fields: [userId], references: [id], onDelete: Cascade) // N:1 addreses:user
  userId String  @map("user_id") // N:1 addreses:user
}

model Contact {
  id        String  @id @default(uuid())
  firstName String
  midName   String?
  lastName  String
  email     String  @unique

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict) // N:1 user:company
  companyId String  @map("company_id") // N:1 user:company

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict) // N:1 user:department
  departmentId String     @map("department_id") // 1:1 user:department

  position   Position @relation(fields: [positionId], references: [id], onDelete: Restrict) // N:1 user:position
  positionId String   @map("position_id") // 1:1 user:position

  addresses Address[] // 1:N user:addresses
  phones    Phone[] // 1:N user:phones
}

//Authentification
model User {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  ADMIN
  USER
}
