generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Region {
  id     String    @id @default(uuid())
  name   String    @unique
  region Address[]
}

model City {
  id   String    @id @default(uuid())
  name String    @unique
  city Address[]
}

model Company {
  id      String    @id @default(uuid())
  name    String    @unique
  company Contact[]

  @@map("Companies")
}

model Department {
  id         String    @id @default(uuid())
  name       String    @unique
  department Contact[]

  @@map("Departments")
}

model Position {
  id       String    @id @default(uuid())
  name     String    @unique
  position Contact[]

  @@map("Positions")
}

model Phone {
  id    String    @id @default(uuid())
  phone String
  type  PhoneType

  userId String
  user   Contact @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("Phones")
}

model Address {
  id        String @id @default(uuid())
  street    String
  building  Int
  apartment Int

  city   City   @relation(fields: [cityId], references: [id])
  cityId String @map("city_id")

  region   Region @relation(fields: [regionId], references: [id])
  regionId String @map("region_id")

  contact Contact?
}

model Contact {
  id        String  @id @default(uuid())
  firstName String
  midName   String?
  lastName  String
  email     String  @unique
  photo     String?

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])

  department   Department @relation(fields: [departmentId], references: [id])
  departmentId String     @map("department_id")

  position   Position @relation(fields: [positionId], references: [id])
  positionId String   @map("position_id")

  addressId String  @unique @map("address_id")
  address   Address @relation(fields: [addressId], references: [id])

  phones Phone[]
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  firstName     String
  lastName      String
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  revoked   Boolean  @default(false)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

enum PhoneType {
  WORK
  MOBILE
  HOME
  OTHER
}

enum Role {
  ADMIN
  USER
}
